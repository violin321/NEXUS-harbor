NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://username:password@localhost:5432/nexus_harbor
ADMIN_EMAILS=
ADMIN_USER_IDS=
# Default is fail-closed: configure ADMIN_EMAILS/ADMIN_USER_IDS for admin access.
# Local-only escape hatch: set true only for temporary development when no allowlist is configured.
ALLOW_UNRESTRICTED_ADMIN=false
ALLOWED_DEV_ORIGINS=
